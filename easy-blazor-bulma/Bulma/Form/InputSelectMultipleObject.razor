@namespace easy_blazor_bulma
@typeparam TItem
@typeparam TValue
@inherits InputBase<List<TValue>>

@if (ShowGroupButtons)
{
    <div class="columns is-variable is-1">
        <div class="column is-6 pt-1 pb-0">
            <button type="button" class="@GroupButtonCssClass" disabled="@AdditionalAttributes.IsDisabled()" @onclick='SelectAll'>Select All</button>
        </div>
        <div class="column is-6 pt-1 pb-0">
            <button type="button" class="@GroupButtonCssClass" disabled="@AdditionalAttributes.IsDisabled()" @onclick='ClearAll'>Clear All</button>
        </div>
    </div>
}

<div class='@MainCssClass'>
    <select class='input' multiple size="@Size" @bind="SelectedIndices" @ref=Element @attributes='AdditionalAttributes.ConvertReadonlyToDisabled().GetFilteredAttributes(Filter)'>
        @for (var i = 0; i < ItemsList.Count; i++)
        {
            <option value="@i">@DisplayValue(ItemsList[i])</option>
        }
    </select>
</div>

@if (string.IsNullOrWhiteSpace(Icon) == false)
{
    <span class="material-icons icon is-left">@Icon</span>
}
