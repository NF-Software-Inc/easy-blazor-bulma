@namespace easy_blazor_bulma
@typeparam TItem
@typeparam TValue
@inherits InputBase<TValue>

<div class='@MainCssClass'>
    <select class='input' @bind="CurrentValueAsString" @ref=Element @attributes='AdditionalAttributes.ConvertReadonlyToDisabled().GetFilteredAttributes(Filter)'>
        @if (IsNullable)
        {
            <option value="">@NullText</option>
        }
        @for (var i = 0; i < ItemsList.Count; i++)
        {
            <option value="@i">@DisplayValue(ItemsList[i])</option>
        }
    </select>
</div>

@if (string.IsNullOrWhiteSpace(Icon) == false)
{
    <span class="material-icons icon is-left">@Icon</span>
}
