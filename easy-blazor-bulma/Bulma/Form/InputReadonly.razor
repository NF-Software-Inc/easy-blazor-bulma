@namespace easy_blazor_bulma
@typeparam TValue
@inherits InputBase<TValue>

<input type="text" class="@MainCssClass" value="@CurrentValueAsString" readonly @ref=Element @attributes='AdditionalAttributes.GetFilteredAttributes(Filter)' />

@if (string.IsNullOrWhiteSpace(Icon) == false)
{
	<span class="@IconCssClass">@Icon</span>
}
