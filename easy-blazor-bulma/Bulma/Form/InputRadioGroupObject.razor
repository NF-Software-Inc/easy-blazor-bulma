@namespace easy_blazor_bulma
@typeparam TValue
@inherits InputBase<TValue>

<div class="@MainCssClass">
	<InputRadioGroup Name="@PropertyName" Value="CurrentValueIdentifier" ValueExpression="() => CurrentValueIdentifier" @attributes='AdditionalAttributes.GetFilteredAttributes(Filter)'>
		@foreach (var option in RadioItems)
		{
			<div class="control">
				<div class="my-1 clickable" @onclick='() => OnCurrentChanged(option.Value)'>
					<InputRadio Name="@PropertyName" class="@ItemCssClass" TValue="string" Value="@option.Identifier" id='@GetRadioOptionId(option.Identifier)' disabled="@AdditionalAttributes.IsDisabled()" />
					<label for='@GetRadioOptionId(option.Identifier)'>@option.Display</label>
				</div>
			</div>
		}
	</InputRadioGroup>
</div>
