@namespace easy_blazor_bulma
@typeparam TValue
@inherits InputBase<TValue>

<InputRadioGroup Name="@PropertyName" class="@MainCssClass" Value="CurrentValueIdentifier" ValueExpression="() => CurrentValueIdentifier" @attributes='AdditionalAttributes.GetFilteredAttributes(Filter)'>
	@foreach (var option in RadioItems)
	{
		<div class="control">
			<div class="my-1 clickable" @onclick='() => OnCurrentChanged(option.Value)'>
				<InputRadio Name="@PropertyName" class="@ItemCssClass" TValue="string" Value="@option.Identifier" id='@GetRadioOptionId(option.Identifier)' @attributes='AdditionalAttributes.ConvertReadonlyToDisabled()?.Where(x => x.Key == "disabled")' />
				<label for='@GetRadioOptionId(option.Identifier)'>@option.Display</label>
			</div>
		</div>
	}
</InputRadioGroup>
