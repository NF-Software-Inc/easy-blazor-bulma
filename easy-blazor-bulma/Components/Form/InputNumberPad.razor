@namespace easy_blazor_bulma
@typeparam TValue
@inherits InputBase<TValue>

@if (DisplayInput)
{
	<input type="text" class="@MainCssClass" id="@InputId" value='@CurrentValueAsString' @ref=Element @onkeydown='OnInputKeyDown' @attributes='AdditionalAttributes.GetFilteredAttributes(Filter)' />
	@if (string.IsNullOrWhiteSpace(Icon) == false)
	{
		<span class="material-icons icon is-left">@Icon</span>
	}
}
else
{
	<input type="hidden" class="is-hidden" value='@CurrentValueAsString' />
}

<div class='@ColumnsCssClass' @ref="KeypadElement">
	<div class='@ColumnCssClass'>
		<button id="@GetButtonId(0, 0)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 0, 0)" @onclick="() => OnDigitClicked(7)">7</button>
		<button id="@GetButtonId(1, 0)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 1, 0)" @onclick="() => OnDigitClicked(4)">4</button>
		<button id="@GetButtonId(2, 0)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 2, 0)" @onclick="() => OnDigitClicked(1)">1</button>
		<button id="@GetButtonId(3, 0)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 3, 0)" @onclick="() => OnResetClicked()">
			@if (IsNullable)
			{
				@:Clear
			}
			else
			{
				@:Reset
			}
		</button>
	</div>
	<div class='@ColumnCssClass'>
		<button id="@GetButtonId(0, 1)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 0, 1)" @onclick="() => OnDigitClicked(8)">8</button>
		<button id="@GetButtonId(1, 1)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 1, 1)" @onclick="() => OnDigitClicked(5)">5</button>
		<button id="@GetButtonId(2, 1)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 2, 1)" @onclick="() => OnDigitClicked(2)">2</button>
		<button id="@GetButtonId(3, 1)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 3, 1)" @onclick="() => OnDigitClicked(0)">0</button>
	</div>
	<div class='@ColumnCssClass'>
		<button id="@GetButtonId(0, 2)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 0, 2)" @onclick="() => OnDigitClicked(9)">9</button>
		<button id="@GetButtonId(1, 2)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 1, 2)" @onclick="() => OnDigitClicked(6)">6</button>
		<button id="@GetButtonId(2, 2)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 2, 2)" @onclick="() => OnDigitClicked(3)">3</button>
		@if (SupportsDecimals)
		{
			<button id="@GetButtonId(3, 2)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 3, 2)" @onclick="() => OnDecimalClicked()">@DecimalSeparator</button>
		}
		else
		{
			<button id="@GetButtonId(3, 2)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, 3, 2)" @onclick="() => OnBackspaceClicked()">
				<span class="material-icons icon">backspace</span>
			</button>
		}
	</div>
</div>

<div @ref="CustomButtonElement">
	@if (OnCustomButtonClicked != null)
	{
		<button id="@GetButtonId(KeypadRows, 0)" type="button" class='@ButtonCssClass' @onkeydown="(args) => OnButtonKeyDown(args, KeypadRows, 0)" @onclick="() => OnCustomButtonClicked.Invoke()">@CustomButtonText</button>
	}
</div>
