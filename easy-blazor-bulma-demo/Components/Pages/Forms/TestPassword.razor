@using System.ComponentModel.DataAnnotations

@page "/inputPassword"
@inherits ComponentBase

<TitleBlock Title="Input Password Test" />

<div class="columns p-3">
	<div class="column is-4">
		<Message Title="Information" Color="BulmaColors.Cyan">
			<p class="block">The Input Password component supports an optional <strong>PasswordValidator</strong> function to check password strength on each change.</p>
			<p class="block">There are several additional attributes that can apply customization to the component:</p>
			<div class="content">
				<ul class="content">
					<li>icon-class</li>
					<li>message-class</li>
				</ul>
			</div>
		</Message>
	</div>
	<div class="column is-8">
		<EditForm Model="InputModel">
			<div class="field">
				<Label For="() => InputModel.PasswordTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left">
					<InputPassword @bind-Value=InputModel.PasswordTest />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.ValidatedPasswordTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left">
					<InputPassword @bind-Value=InputModel.ValidatedPasswordTest PasswordValidator="ValidatePassword" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.NullablePasswordTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left">
					<InputPassword @bind-Value=InputModel.NullablePasswordTest PasswordValidator="ValidatePassword" />
				</div>
			</div>
		</EditForm>
	</div>
</div>

@code {
	private readonly PageModel InputModel = new();

	private readonly TooltipOptions TooltipDisplayMode = TooltipOptions.Right | TooltipOptions.HasArrow | TooltipOptions.Multiline;

	private (bool IsValid, string? Message) ValidatePassword(string? value)
	{
		if (string.IsNullOrWhiteSpace(value))
			return (false, "Password is required.");

		if (value.Length < 8)
			return (false, "Must be at least 8 characters.");

		var hasUpper = value.Any(char.IsUpper);
		var hasDigit = value.Any(char.IsDigit);
		var hasSpecial = value.Any(c => char.IsLetterOrDigit(c) == false);

		if (hasUpper == false || hasDigit == false || hasSpecial == false)
			return (false, "Must include an uppercase letter, a number, and a special character.");

		return (true, "Strong password.");
	}

	private class PageModel
	{
		[Display(Name = "Password Test", Description = "Input to test a basic password field with no validator.")]
		public string PasswordTest { get; set; } = string.Empty;

		[Display(Name = "Validated Password Test", Description = "Input to test password strength validation.")]
		public string ValidatedPasswordTest { get; set; } = string.Empty;

		[Display(Name = "Nullable Password Test", Description = "Input to test password strength validation with a nullable value.")]
		public string? NullablePasswordTest { get; set; }
	}
}
