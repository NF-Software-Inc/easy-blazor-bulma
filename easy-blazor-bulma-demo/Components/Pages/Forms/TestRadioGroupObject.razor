@page "/inputRadioGroupObject"
@inherits ComponentBase

<TitleBlock Title="Input Radio Group Object Test" />

<div class="columns p-3">
	<div class="column is-4">
		<Message Title="Information" Color="BulmaColors.Cyan">
			<p class="block">Provide either an Options dictionary, or RadioOptions with a DisplayValue function. The examples below maintain separate selections.</p>
			<p class="block">There are several additional attributes that can apply customization to the component:</p>
			<div class="content">
				<ul class="content">
					<li>item-class</li>
				</ul>
			</div>
		</Message>
	</div>
	<div class="column is-8">
		<EditForm Model="InputModel">
			<div class="field">
				<label class="label">Selected Employee (Dictionary)</label>
				<InputRadioGroupObject @bind-Value=InputModel.Selected1 Options="EmployeeDictionaryOptions" />
				<p class="help">Dictionary keys provide the labels. Nobody explicitly selects null.</p>
			</div>
			<div class="field">
				<button class="button" @onclick=OnButtonClicked>Vote for Jimbo!</button>
			</div>

			<div class="field">
				<label class="label">Selected Employee (List)</label>
				<InputRadioGroupObject @bind-Value="InputModel.Selected2" RadioOptions="EmployeeListOptions" DisplayValue='x => x?.Name ?? "Nobody"' />
				<p class="help">RadioOptions provides the employees, and DisplayValue supplies each employee's name.</p>
			</div>

			<div class="field">
				<label class="label">Selected Employee (Dynamic Attributes)</label>
				<InputRadioGroupObject @bind-Value="InputModel.Selected3" Options="EmployeeDictionaryOptions" AdditionalAttributes="ControlAttributes" />
				<p class="help">State: @ControlState. Disable or make the control read-only, then enable it again to verify that selection is restored without clearing the current value.</p>
			</div>
			<div class="buttons">
				<button type="button" class="button is-success" @onclick="EnableControl">Enable</button>
				<button type="button" class="button is-danger" @onclick="DisableControl">Disable</button>
				<button type="button" class="button is-warning" @onclick="MakeControlReadOnly">Make read-only</button>
			</div>
		</EditForm>

		<Message class="mt-3" Title="Current Values" Color="BulmaColors.Green">
			<p class="block">Dictionary selection: @(InputModel.Selected1?.Name ?? "Nobody")</p>
			<p class="block">List selection: @(InputModel.Selected2?.Name ?? "Nobody")</p>
			<p class="block">Dynamic attributes selection: @(InputModel.Selected3?.Name ?? "Nobody")</p>
		</Message>
	</div>
</div>
