@using System.ComponentModel.DataAnnotations

@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.SelectedApplicantIds" TooltipMode="AutocompleteSampleData.TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    <InputAutocompleteMultiple dropdown-class="is-fullwidth"
                                               @bind-Value="InputModel.SelectedApplicantIds"
                                               ValueSelector="x => x.Id"
                                               DisplayValue="x => x.Name"
                                               DisplayFilter="(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)"
                                               Items="AutocompleteSampleData.Applicants"
                                               Options="Options" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block">This input binds a list of selected applicant IDs instead of the full objects.</p>
            <div class="is-size-7">
                <p>Selected applicant IDs (@InputModel.SelectedApplicantIds.Count):</p>
                @if (InputModel.SelectedApplicantIds.Count == 0)
                {
                    <p class="block">None</p>
                }
                else
                {
                    <div class="content">
                        <ul>
                            @foreach (var id in InputModel.SelectedApplicantIds)
                            {
                                <li>@id</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </Message>
    </div>
</div>

@code {
    private readonly ApplicantIdsExampleModel InputModel = new();

    private readonly InputAutocompleteOptions Options =
        InputAutocompleteOptions.TypePopout |
        InputAutocompleteOptions.ClickPopout |
        InputAutocompleteOptions.PopoutTop |
        InputAutocompleteOptions.UseAutomaticStatusColors |
        InputAutocompleteOptions.AutoSelectOnExit;

    private class ApplicantIdsExampleModel
    {
        [Display(Name = "Applicant IDs", Description = "Select multiple applicants while binding only their IDs.")]
        public List<int> SelectedApplicantIds { get; set; } = [AutocompleteSampleData.Applicants[3].Id, AutocompleteSampleData.Applicants[7].Id];
    }
}