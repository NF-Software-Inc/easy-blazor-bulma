@using System.ComponentModel.DataAnnotations

@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.FieldSelection" TooltipMode="AutocompleteSampleData.TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    <InputAutocomplete dropdown-class="is-fullwidth"
                                       @bind-Value="InputModel.FieldSelection"
                                       DisplayValue="x => x.Name"
                                       DisplayFilter="(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)"
                                       Items="AutocompleteSampleData.Applicants" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block">This input binds to a model field instead of a property.</p>
            <div class="is-size-7">
                <p>The selected applicant is:</p>
                <div class="content">
                    <ul>
                        <li>Name: @InputModel.FieldSelection?.Name</li>
                        <li>Position: @InputModel.FieldSelection?.Position</li>
                    </ul>
                </div>
            </div>
        </Message>
    </div>
</div>

@code {
    private readonly FieldBindingExampleModel InputModel = new();

    private class FieldBindingExampleModel
    {
        /// <summary>
        /// The currently selected applicant from the autocomplete input, bound to a model field instead of a property.
        /// </summary>
        [Display(Name = "Field Applicant", Description = "Select an applicant using a field instead of property.")]
        public DemoAutocomplete? FieldSelection = AutocompleteSampleData.Applicants[1];
    }
}