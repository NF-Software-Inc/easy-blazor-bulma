@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <div class="field">
            <Label TValue="object" DisplayText="Private Member" />
            <div class="control has-icons-left is-expanded">
                <InputAutocomplete dropdown-class="is-fullwidth"
                                   @bind-Value="PrivateSelection"
                                   DisplayValue="x => x.Name"
                                   DisplayFilter="(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)"
                                   Items="AutocompleteSampleData.Applicants" />
            </div>
        </div>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block">This input binds to a private component property outside a form model.</p>
            <div class="is-size-7">
                <p>The selected applicant is:</p>
                <div class="content">
                    <ul>
                        <li>Name: @PrivateSelection?.Name</li>
                        <li>Position: @PrivateSelection?.Position</li>
                    </ul>
                </div>
            </div>
        </Message>
    </div>
</div>

@code {
    /// <summary>
    /// The currently selected applicant from the autocomplete input, bound to a private property outside of a form model.
    /// </summary>
    private DemoAutocomplete? PrivateSelection { get; set; } = AutocompleteSampleData.Applicants[0];
}