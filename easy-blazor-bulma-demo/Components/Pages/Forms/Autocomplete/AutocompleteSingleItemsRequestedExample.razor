@using System.ComponentModel.DataAnnotations

@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.SelectedApplicant" TooltipMode="AutocompleteSampleData.TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    <InputAutocomplete dropdown-class="is-fullwidth"
                                       tag-class="is-warning"
                                       @bind-Value="InputModel.SelectedApplicant"
                                       DisplayValue="x => x.Name"
                                       Items="GetAutocompleteItems()"
                                       OnItemsRequested="OnItemsRequested"
                                       DisplayCount="5"
                                       Options="Options" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block is-size-6">This input displays a more customized implementation. By using the <b>OnItemsRequested</b> method, the collection can be filtered before the value gets changed. In this case, typing <b>More</b> will add a new element to the list and typing <b>Less</b> will remove an element from the list.</p>
            <p></p>
            <div class="is-size-7">
            <p>The person to be hired for the Accountant position is:</p>
            <div class="content">
                <ul>
                    <li>Name: @InputModel.SelectedApplicant?.Name</li>
                    <li>Age: @InputModel.SelectedApplicant?.Age</li>
                    <li>Profession: @InputModel.SelectedApplicant?.Position</li>
                </ul>
            </div>
            </div>
        </Message>
    </div>
</div>

@code {
    private static readonly List<DemoAutocomplete> AllItems = AutocompleteSampleData.Applicants;

    private readonly AccountantExampleModel InputModel = new();

    /// <summary>
    /// The current filter value used to filter the autocomplete items.
    /// </summary>
    private string? Filter;

    /// <summary>
    /// Used to configure the behavior of the InputAutocomplete component. In this example, the options are set to display the popout above the input field and to use automatic status colors for the input field.
    /// </summary>
    private readonly InputAutocompleteOptions Options =
        InputAutocompleteOptions.TypePopout |
        InputAutocompleteOptions.PopoutTop |
        InputAutocompleteOptions.UseAutomaticStatusColors;

    /// <summary>
    /// Returns a filtered list of autocomplete items based on the current filter value. If the filter is not empty, it returns only those items whose names start with the filter value and whose position is "Accountant". If the filter is empty, it returns all items with the position "Accountant".
    /// </summary>
    private IEnumerable<DemoAutocomplete> GetAutocompleteItems()
    {
        if (string.IsNullOrWhiteSpace(Filter) == false)
            return AllItems.Where(x => x.Position == "Accountant" && x.Name.StartsWith(Filter, StringComparison.OrdinalIgnoreCase));

        return AllItems.Where(x => x.Position == "Accountant");
    }

    /// <summary>
    /// Handles the event when autocomplete items are requested, i.e., when the user types in the input field. Updates the filter value and modifies the list of items based on the input value.
    /// </summary>
    /// <param name="value">The current filter value entered by the user.</param>
    private async Task OnItemsRequested(string? value)
    {
        Filter = value;

        if (value != null && value.Equals("More", StringComparison.OrdinalIgnoreCase))
        {
            AllItems.Add(new DemoAutocomplete { Id = AllItems.Max(x => x.Id) + 1, Name = "Dupie Duplicado", Age = 99, Position = "Accountant" });
        }
        else if (value != null && value.Equals("Less", StringComparison.OrdinalIgnoreCase))
        {
            var remove = AllItems.FirstOrDefault(x => x.Position == "Accountant");

            if (remove != null)
                AllItems.Remove(remove);
        }

        await Task.CompletedTask;
        StateHasChanged();
    }

    /// <summary>
    /// The example model used as the input model for the form.
    /// </summary>
    private class AccountantExampleModel
    {
        [Display(Name = "Accountant Applicant", Description = "Please type the name of the applicant to hire for the Accountant position.")]
        public DemoAutocomplete? SelectedApplicant { get; set; }
    }
}

