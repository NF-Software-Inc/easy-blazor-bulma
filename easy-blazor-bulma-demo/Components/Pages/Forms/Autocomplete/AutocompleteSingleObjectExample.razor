@using System.ComponentModel.DataAnnotations

@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.SelectedApplicant" TooltipMode="AutocompleteSampleData.TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    <InputAutocomplete dropdown-class="is-fullwidth"
                                       @bind-Value="InputModel.SelectedApplicant"
                                       DisplayValue="x => x.Name"
                                       DisplayFilter="(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)"
                                       Items="AutocompleteSampleData.Applicants" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block">This input displays a generic implementation.</p>

            <div class="is-size-7">
                <p>The person to be hired for the Janitor position is:</p>
                <div class="content">
                    <ul>
                        <li>Name: @InputModel.SelectedApplicant?.Name</li>
                        <li>Position: @((InputModel.SelectedApplicant as DemoAutocomplete)?.Position)</li>
                    </ul>
                </div>
            </div>
        </Message>
    </div>

</div>

@code {
	private readonly JanitorExampleModel InputModel = new();

	/// <summary>
	/// The example model used as the input model for the form.
	/// </summary>
	private class JanitorExampleModel
	{
		/// <summary>
		/// The selected applicant for the Janitor position.
		/// </summary>
		[Display(Name = "Janitor Applicant", Description = "Please type the name of the applicant to hire for the Janitor position.")]
		public IAutocomplete SelectedApplicant { get; set; } = AutocompleteSampleData.Applicants[0];
	}
}