@using System.ComponentModel.DataAnnotations

@namespace easy_blazor_bulma_demo.Components.Pages.Forms

<div class="columns">
    <div class="column">
        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.SelectedApplicantId" TooltipMode="AutocompleteSampleData.TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    <InputAutocomplete dropdown-class="is-fullwidth"
                                       @bind-Value="InputModel.SelectedApplicantId"
                                       ValueSelector="x => x.Id"
                                       DisplayValue="x => x.Name"
                                       DisplayFilter="(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)"
                                       Items="AutocompleteSampleData.Applicants" />
                </div>
            </div>
        </EditForm>
    </div>

    <div class="column">
        <Message Color="BulmaColors.Green">
            <p class="block">This input binds the selected applicant's ID instead of the full object.</p>
            <div class="is-size-7">
                <p>Selected applicant ID: @(InputModel.SelectedApplicantId?.ToString() ?? "Null")</p>
            </div>
        </Message>
    </div>
</div>

@code {
    private readonly ApplicantIdExampleModel InputModel = new();

    private class ApplicantIdExampleModel
    {
        [Display(Name = "Applicant ID", Description = "Select an applicant while binding only their ID.")]
        public int? SelectedApplicantId { get; set; } = AutocompleteSampleData.Applicants[7].Id;
    }
}