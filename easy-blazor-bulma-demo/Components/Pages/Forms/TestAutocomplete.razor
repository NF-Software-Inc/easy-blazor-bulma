@using easy_blazor_bulma_demo.Services

@page "/inputAutocomplete"
@inherits ComponentBase

<TitleBlock Title="Input Autocomplete Test" />

<div class="columns p-3">
    <div class="column is-4">
        <Message Title="Information" Color="BulmaColors.Cyan">
            <ComponentInfo ComponentType="AutocompleteType">
            <p class="block">Note that the Input Autocomplete component supports keyboard navigation using the following keys:</p>
            <div class="content">
                <ul class="content">
                    <li>Up Arrow</li>
                    <li>Down Arrow</li>
                    <li>Left Arrow</li>
                    <li>Right Arrow</li>
                    <li>Tab</li>
                    <li>Enter</li>
                    <li>Esc</li>
                </ul>
            </div>

            <p class="block">There are several additional attributes that can apply customization to the component:</p>
            <div class="content">
                <ul class="content">
                    <li>dropdown-class</li>
                    <li>dropdown-trigger-class</li>
                    <li>dropdown-menu-class</li>
                    <li>dropdown-item-class</li>
                    <li>tag-class</li>
                </ul>
            </div>
            </ComponentInfo>

            <p class="block">
                <b>Looking for every option?</b>
                <a class="is-clickable" @onclick="JumpToParameters">View all parameters ↓</a>
            </p>
        </Message>
    </div>
    <div class="column is-8">

        <ExampleSection ComponentType="typeof(AutocompleteSingleObjectExample)"/>
        <ExampleSection ComponentType="typeof(AutocompleteSingleItemsRequestedExample)"/>
        <ExampleSection ComponentType="typeof(AutocompleteSingleAutoSelectExample)"/>
        <ExampleSection ComponentType="typeof(AutocompleteMultipleObjectsExample)"/>
        <ExampleSection ComponentType="typeof(AutocompleteSingleIdExample)"/>
        <ExampleSection ComponentType="typeof(AutocompleteMultipleIdsExample)"/>

        <EditForm Model="InputModel">
            <div class="field">
                <Label For="() => InputModel.FieldSelection" TooltipMode="TooltipDisplayMode" />
                <div class="control has-icons-left is-expanded">
                    @* Single selection bound to a model field rather than a property. *@
                    <InputAutocomplete dropdown-class="is-fullwidth" @bind-Value="InputModel.FieldSelection" DisplayValue='x => x.Name' DisplayFilter='(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)' Items="AllItems" />
                </div>
            </div>
            <div class="field">
                <Label TValue="object" DisplayText="Private Member" />
                <div class="control has-icons-left is-expanded">
                    @* Single selection bound to a private component property outside the form model. *@
                    <InputAutocomplete dropdown-class="is-fullwidth" @bind-Value="PrivateSelection" DisplayValue='x => x.Name' DisplayFilter='(x, y) => x.Name.StartsWith(y, StringComparison.OrdinalIgnoreCase)' Items="AllItems" />
                </div>
            </div>
        </EditForm>
    </div>
</div>

<hr class="m-2 has-background-light" />

@* Parameter Table *@
<section @ref="ParametersSection" tabindex="-1" class="p-3">
    <ApiTable ComponentType="AutocompleteType" />
    <ApiTable ComponentType="AutocompleteMultipleType" />
</section>