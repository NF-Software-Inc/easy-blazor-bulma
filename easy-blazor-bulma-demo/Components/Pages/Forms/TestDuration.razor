@page "/inputDuration"
@inherits ComponentBase

<TitleBlock Title="Input Duration Test" />

<div class="columns p-3">
	<div class="column is-4">
		<Message Title="Information" Color="BulmaColors.Cyan">
			<p class="block">Formatting can be applied with the <strong>DisplayFormat</strong> parameter or the <strong>Formatter</strong> function.</p>
			<p class="block">The largest displayed column carries the total duration and its sign. Entering a value into it replaces the current value, so entering a negative there flips the entire duration.</p>
			<p class="block">Entering a value into any other column replaces that column when it falls within its natural range, otherwise the value is added to the current duration. Try entering 90 minutes, or -2 hours.</p>
			<p class="block">There are several additional attributes that can apply customization to the component:</p>
			<div class="content">
				<ul class="content">
					<li>datetimepicker-class</li>
					<li>icon-class</li>
				</ul>
			</div>
		</Message>
	</div>
	<div class="column is-8">
		<EditForm Model="InputModel">
			<div class="field">
				<Label For="() => InputModel.TimeSpanTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left has-icons-right">
					<InputDuration @bind-Value=InputModel.TimeSpanTest />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.TimeOnlyTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left has-icons-right">
					<InputDuration @bind-Value=InputModel.TimeOnlyTest Options="Options" StepSeconds="30" StepMilliseconds="50" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.SignedTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left has-icons-right">
					<InputDuration @bind-Value=InputModel.SignedTest Options="SignedOptions" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.RollupTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left has-icons-right">
					<InputDuration @bind-Value=InputModel.RollupTest Options="RollupOptions" StepMinutes="15" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.FormattedTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left has-icons-right">
					<InputDuration @bind-Value=InputModel.FormattedTest Options="SignedOptions" Formatter="FormatDuration" />
				</div>
			</div>
		</EditForm>
	</div>
</div>
