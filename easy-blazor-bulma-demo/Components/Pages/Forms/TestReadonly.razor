@using System.ComponentModel.DataAnnotations

@page "/inputReadonly"
@inherits ComponentBase

<TitleBlock Title="Input Readonly Test" />

<div class="columns p-3">
	<div class="column is-4">
		<Message Title="Information" Color="BulmaColors.Cyan">
			<p class="block">The Input Readonly component displays a value that cannot be edited. Any type is supported.</p>
			<p class="block">Formatting can be applied with the <strong>DisplayFormat</strong> parameter or the <strong>Formatter</strong> function.</p>
			<p class="block">There is one additional attribute that can apply customization to the component:</p>
			<div class="content">
				<ul class="content">
					<li>icon-class</li>
				</ul>
			</div>
		</Message>
	</div>
	<div class="column is-8">
		<EditForm Model="InputModel">
			<div class="field">
				<Label For="() => InputModel.TextTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left">
					<InputReadonly @bind-Value=InputModel.TextTest Icon="badge" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.DateTest" TooltipMode="TooltipDisplayMode" />
				<div class="control has-icons-left">
					<InputReadonly @bind-Value=InputModel.DateTest DisplayFormat="D" Icon="calendar_month" />
				</div>
			</div>
			<div class="field">
				<Label For="() => InputModel.NullableTest" TooltipMode="TooltipDisplayMode" />
				<div class="control">
					<InputReadonly @bind-Value=InputModel.NullableTest DisplayFormat="C2" NullText="Not provided" IsStatic="true" />
				</div>
			</div>
		</EditForm>
	</div>
</div>

@code {
	private readonly PageModel InputModel = new();

	private readonly TooltipOptions TooltipDisplayMode = TooltipOptions.Right | TooltipOptions.HasArrow | TooltipOptions.Multiline;

	private class PageModel
	{
		[Display(Name = "Text Test", Description = "Input to test a readonly text value.")]
		public string TextTest { get; set; } = "Read only value";

		[Display(Name = "Date Test", Description = "Input to test a readonly date value with custom formatting.")]
		public DateTime DateTest { get; set; } = DateTime.Now;

		[Display(Name = "Nullable Test", Description = "Input to test a null value displayed as static text.")]
		public decimal? NullableTest { get; set; }
	}
}
