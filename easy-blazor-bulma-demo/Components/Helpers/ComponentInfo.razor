@using easy_blazor_bulma_demo.Services

@inherits ComponentBase

@if (string.IsNullOrEmpty(Title) == false)
{
	<h3 class="title is-5">@Title</h3>
}

<div class="block">@XmlDocs.ToHtml(TypeDoc?.Element("summary"))</div>

@* Bulma only draws bullet points for lists inside .content *@
<div class="block content">@XmlDocs.ToHtml(TypeDoc?.Element("remarks"))</div>

@if (TypeParams.Count > 0)
{
	<p class="has-text-weight-bold">Generic Types</p>
	<p class="is-size-7 mt-1">Set these on the component, e.g. TItem="Person", if the compiler can't figure them out.</p>
	<div class="content">
		<ul>
			@foreach (var tp in TypeParams)
			{
				<li><code>@tp.Name</code>: @tp.Description</li>
			}
		</ul>
	</div>
}

@ChildContent