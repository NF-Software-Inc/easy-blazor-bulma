@inherits ComponentBase

<div class="box">
    <h3 class="title is-5">@Heading</h3>

    <div class="table-container">
        <table class="table is-fullwidth is-striped is-narrow">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td><b>@row.Name</b></td>
                        <td><code>@row.Type</code></td>
                        <td>
                            @row.Description

                            @if (string.IsNullOrEmpty(row.Remarks.Value) == false)
                            {
                                <div class="is-size-7 mt-1">@row.Remarks</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>